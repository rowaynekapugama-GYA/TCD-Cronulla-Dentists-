# ---- Dashboard (Payload CMS at /admin) ----
# Neon Postgres connection string (Vercel > Storage > Neon, or neon.tech). Include ?sslmode=require
DATABASE_URL=
# Any long random string. Signs dashboard logins. Generate: openssl rand -hex 32
PAYLOAD_SECRET=
# Vercel Blob store token (Vercel > Storage > Blob). Media uploads go here.
BLOB_READ_WRITE_TOKEN=
# Vercel deploy hook for the production branch (Vercel > Settings > Git > Deploy Hooks). The Publish button calls it.
PUBLISH_HOOK_URL=
# The site's public address, no trailing slash.
NEXT_PUBLIC_SERVER_URL=https://www.thecronulladentists.com.au

# ---- Forms (SMTP2GO -> SmileOx) ----
SMTP2GO_API_KEY=
SMTP2GO_SENDER=website@thecronulladentists.com.au
SMILEOX_INTAKE_EMAIL=
NOTIFY_EMAIL=reception@thecronulladentists.com.au, rowayne@gyaclients.com
